rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chip In HQ is the only Firebase-authenticated writer/reader.
    // Replace FIREBASE_UID with the UID shown inside HQ after first connection.
    match /chipinSalesAssistant/{document} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'FIREBASE_UID';
    }

    // Everything else stays closed to Firebase client users.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
